# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit real values.

# ── Required ──────────────────────────────────────────────────────────────────
domain_name       = "mc.example.com"
availability_zone = "eu-west-1a"   # Must match the AZ of your world data EBS volume

# ── Common ────────────────────────────────────────────────────────────────────
hosted_zone_id      = ""           # Existing zone ID, or empty to create a new one
aws_region          = "eu-west-1"
instance_type       = "t3.medium"
inactivity_minutes  = 20
minecraft_version   = "latest"     # or a specific version like "1.20.4"
minecraft_memory_mb = 2048
spot_instance       = false
# key_name          = "my-key-pair" # EC2 key pair for SSH; omit to disable SSH

# ── Optional: Minecraft server.properties overrides ───────────────────────────
# server_properties = {
#   difficulty  = "hard"
#   gamemode    = "survival"
#   max-players = "10"
# }

# ── Optional: Operators (admin players) ───────────────────────────────────────
# ops = [
#   { uuid = "069a79f4-44e9-4726-a5be-fca90e38aaf5", name = "Notch" },
# ]

# ── Optional: Whitelist (setting any entry enables white-list=true) ───────────
# whitelist = [
#   { uuid = "069a79f4-44e9-4726-a5be-fca90e38aaf5", name = "Notch" },
# ]

# ── Optional: Banned players ──────────────────────────────────────────────────
# banned = [
#   { uuid = "069a79f4-44e9-4726-a5be-fca90e38aaf5", name = "Notch", reason = "spawn-camping" },
# ]
